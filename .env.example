# Copy to .env.local and fill in. Never commit real values.

# Supabase → Project Settings → API (or the "Connect" dialog).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...). A legacy "anon" key also works here.
# Never put the secret / service_role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Public base URL, used for auth email links and canonical/Open Graph URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
